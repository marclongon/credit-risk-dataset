def evaluate_credit_risk(model, customer_data):

    # Predict default probability
    probability = model.predict_proba(customer_data)[:, 1]

    results = []

    for pd in probability:

        if pd < 0.10:
            risk = "Low Risk"
            decision = "Automatic Approval"

        elif pd < 0.30:
            risk = "Medium Risk"
            decision = "Standard Review"

        elif pd < 0.60:
            risk = "High Risk"
            decision = "Additional Analysis"

        else:
            risk = "Very High Risk"
            decision = "Rejection Review"

        results.append({
            "default_probability": round(float(pd), 4),
            "risk_category": risk,
            "suggested_action": decision
        })

    return results

